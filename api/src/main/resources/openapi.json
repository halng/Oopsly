            "format": "date-time"
          }
        }
      },
      "CardItemReq": {
        "type": "object",
        "description": "Card update request",
        "properties": {
          "front": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1
          },
          "back": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1
          }
        },
        "required": [
          "back",
          "front"
        ]
      },
      "UpdateDifficultyReq": {
