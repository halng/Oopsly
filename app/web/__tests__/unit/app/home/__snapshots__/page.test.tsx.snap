            />
          </svg>
        </div>
        <div>
          <h3
            class="text-sm font-bold text-stone-900 dark:text-stone-100 flex items-center gap-1.5"
          >
            <span>
              4
               Total Cards Due for Daily FSRS Review
            </span>
            <span
              class="text-[10px] uppercase font-extrabold px-2 py-0.5 rounded bg-amber-100 dark:bg-amber-900 text-amber-800 dark:text-amber-200"
            >
              Spaced Repetition
            </span>
          </h3>
          <p
            class="text-xs text-stone-600 dark:text-stone-400 mt-0.5"
          >
            Select any shelf below to dive into its subject decks and start active recall.
          </p>
        </div>
      </div>
    </div>
    <div
      class="flex flex-col md:flex-row items-stretch md:items-center gap-3"
    >
      <div
        class="relative flex-1"
      >
        <svg
          aria-hidden="true"
          class="lucide lucide-search w-4 h-4 text-stone-400 absolute left-3.5 top-1/2 -translate-y-1/2"
