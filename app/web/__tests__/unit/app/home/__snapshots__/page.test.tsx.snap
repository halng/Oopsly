    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5"
    >
      <div
        class="bg-white dark:bg-stone-900 rounded-3xl border border-stone-200/80 dark:border-stone-800 shadow-xs hover:shadow-lg transition-all duration-200 flex flex-col justify-between overflow-hidden group hover:border-[color-mix(in_srgb,var(--theme-accent)_50%,transparent)] relative cursor-pointer"
        data-testid="shelf-card-s1"
        id="shelf-card-s1"
      >
