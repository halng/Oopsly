          data-testid="search-shelves-input"
          id="search-shelves-input"
          placeholder="Search shelves..."
          type="text"
          value=""
        />
      </div>
      <div
        class="relative flex-1"
      >
        <svg
          aria-hidden="true"
          class="lucide lucide-search w-4 h-4 text-stone-400 absolute left-3.5 top-1/2 -translate-y-1/2"
          fill="none"
          height="24"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          width="24"
