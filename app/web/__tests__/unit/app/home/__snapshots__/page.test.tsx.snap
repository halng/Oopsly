                  <circle
                    cx="12"
                    cy="5"
                    r="1"
                  />
                  <circle
                    cx="12"
                    cy="19"
                    r="1"
                  />
                </svg>
              </button>
            </div>
          </div>
          <p
            class="text-xs text-stone-600 dark:text-stone-400 line-clamp-2 mt-4 leading-relaxed min-h-[32px]"
          >
            Core science
          </p>
          <div
            class="flex items-center gap-2 mt-4 pt-3 border-t border-stone-100 dark:border-stone-800/80"
          >
            <span
              class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-amber-50 dark:bg-amber-950 text-amber-800 dark:text-amber-300 text-[11px] font-bold border border-amber-200 dark:border-amber-800"
            >
              <span
                class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"
              />
              4
               cards due
            </span>
          </div>
        </div>
        <div
          class="px-6 py-3.5 bg-stone-50/80 dark:bg-stone-800/50 border-t border-stone-100 dark:border-stone-800 flex items-center justify-between"
        >
          <span
            class="text-xs font-bold text-[var(--theme-secondary)] dark:text-[var(--theme-accent)] flex items-center gap-1 group-hover:translate-x-1 transition-transform"
          >
            <span>
              Explore 
              2
               
              Subjects
            </span>
            <svg
              aria-hidden="true"
              class="lucide lucide-chevron-right w-4 h-4"
              fill="none"
              height="24"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 24 24"
              width="24"
