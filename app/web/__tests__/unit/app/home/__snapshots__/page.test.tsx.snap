                  />
                </svg>
              </div>
              <div
                class="min-w-0"
              >
                <h3
                  class="text-lg font-bold text-stone-900 dark:text-stone-100 group-hover:text-[var(--theme-secondary)] dark:group-hover:text-[var(--theme-accent)] transition-colors line-clamp-1"
                >
                  Science
                </h3>
                <div
                  class="flex items-center gap-2 mt-0.5"
                >
                  <span
