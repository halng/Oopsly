            class="flex items-start justify-between gap-3"
          >
            <div
              class="flex items-center gap-3.5 min-w-0 flex-1"
            >
              <div
                class="w-12 h-12 rounded-2xl flex items-center justify-center text-white shadow-2xs font-bold text-lg shrink-0 group-hover:scale-105 transition-transform"
                style="background-color: var(--theme-accent);"
              >
                <svg
                  aria-hidden="true"
                  class="lucide lucide-folder w-6 h-6"
