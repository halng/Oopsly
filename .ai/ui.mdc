## Common Patterns

### Loading State Pattern

```typescript
function UserProfile({ userId }: { userId: string }) {
  const [user, setUser] = useState<User | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  
  useEffect(() => {
    const fetchUser = async () => {
      try {
        setLoading(true);
        const response = await UserService.getUser(userId);
        if (response.isSuccess) {
          setUser(response.data);
        } else {
          setError(response.message);
        }
      } catch (err) {
        setError('Failed to load user');
      } finally {
        setLoading(false);
      }
    };
    
    fetchUser();
  }, [userId]);
  
  if (loading) {
    return <ActivityIndicator testID="loading-spinner" />;
  }
  
  if (error) {
    return <Text testID="error-message">{error}</Text>;
  }
  
  if (!user) {
    return <Text testID="empty-state">User not found</Text>;
  }
  
  return <Text testID="user-name">{user.name}</Text>;
}
```

### Form Validation Pattern

```typescript
function RegistrationForm() {
  const [email, setEmail] = useState('');
  const [emailError, setEmailError] = useState('');
  
  const validateEmail = (value: string) => {
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!value) {
      setEmailError('Email is required');
      return false;
    }
    if (!emailRegex.test(value)) {
      setEmailError('Please enter a valid email');
      return false;
    }
    setEmailError('');
    return true;
  };
  
  const handleSubmit = () => {
    if (validateEmail(email)) {
      // Submit form
    }
  };
  
  return (
    <View>
      <TextInput
        testID="email-input"
        value={email}
        onChangeText={setEmail}
        onBlur={() => validateEmail(email)}
        className="border border-gray-300 rounded-md p-3"
      />
      {emailError && (
        <Text testID="email-error" className="text-red-500 text-sm mt-1">
          {emailError}
        </Text>
      )}
    </View>
  );
}
```

