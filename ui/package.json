{
  "name": "oopsly",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start -c",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "e2e:cypress:open": "TS_NODE_PROJECT=./cypress/tsconfig.json cypress open",
    "e2e:cypress:run": "TS_NODE_PROJECT=./cypress/tsconfig.json cypress run --headless --browser electron",
    "e2e:cypress:run:auth": "TS_NODE_PROJECT=./cypress/tsconfig.json cypress run --headless --browser electron --spec 'cypress/e2e/auth*.cy.ts,cypress/e2e/welcome.cy.ts'",
    "web:coverage": "CYPRESS_COVERAGE=true BABEL_ENV=cypress CI=1 EXPO_NO_TELEMETRY=1 expo start --web --port 8081",
    "e2e:cypress:ci": "WAIT_ON_TIMEOUT=180000 start-server-and-test \"pnpm web:coverage\" http-get://127.0.0.1:8081 \"pnpm e2e:cypress:run\"",
    "coverage:report": "node scripts/sanitize-nyc-output.js && nyc report --reporter=text --reporter=text-summary --reporter=lcov --reporter=json --report-dir=coverage-cypress",
    "coverage:report:cypress": "pnpm coverage:report",
    "coverage:check:e2e": "node scripts/check-e2e-coverage.js",
    "coverage:merge": "node scripts/merge-coverage.js",
    "test:coverage": "jest --coverage --coverageReporters=text --coverageReporters=text-summary --coverageReporters=lcov --coverageReporters=json",
    "reset:deps": "rm -rf node_modules pnpm-lock.yaml .expo"
  },
  "dependencies": {
    "@expo/html-elements": "0.12.5",
    "@expo/metro-runtime": "6.1.2",
    "@expo/vector-icons": "15.0.3",
    "@gluestack-ui/core": "3.0.10",
    "@gluestack-ui/utils": "3.0.11",
    "@gorhom/bottom-sheet": "5.2.6",
    "@legendapp/motion": "2.4.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "7.4.9",
    "@react-navigation/elements": "2.6.5",
    "@react-navigation/native": "7.1.24",
    "@testing-library/react-native": "^13.3.3",
    "axios": "^1.13.2",
    "babel-plugin-module-resolver": "5.0.2",
    "date-fns": "4.1.0",
    "eas": "^0.1.0",
    "expo": "54.0.33",
    "expo-blur": "15.0.8",
    "expo-constants": "18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-font": "14.0.11",
    "expo-haptics": "15.0.8",
    "expo-image": "3.0.11",
    "expo-linear-gradient": "15.0.8",
    "expo-linking": "8.0.11",
    "expo-router": "6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-speech": "^14.0.8",
    "expo-splash-screen": "31.0.13",
    "expo-status-bar": "3.0.9",
    "expo-symbols": "1.0.8",
    "expo-system-ui": "6.0.9",
    "expo-web-browser": "15.0.10",
    "jest-expo": "~54.0.17",
    "lucide-react-native": "0.510.0",
    "nativewind": "4.2.1",
    "react": "19.1.0",
    "react-aria": "3.44.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-chart-kit": "^6.12.0",
    "react-native-css-interop": "0.2.1",
    "react-native-gesture-handler": "2.28.0",
    "react-native-gifted-charts": "1.4.64",
    "react-native-linear-gradient": "2.8.3",
    "react-native-logs": "^5.5.0",
    "react-native-reanimated": "4.1.3",
    "react-native-safe-area-context": "5.6.1",
    "react-native-screens": "4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-uuid": "^2.0.3",
    "react-native-web": "0.21.1",
    "react-native-web-linear-gradient": "1.1.2",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "react-router": "7.8.2",
    "react-router-dom": "7.8.2",
    "react-stately": "3.42.0",
    "tailwind-variants": "0.1.20",
    "tailwindcss": "3.4.18",
    "ulid": "^3.0.2",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@cypress/code-coverage": "^3.14.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/jest": "^29.5.14",
    "@types/react": "19.1.17",
    "axios-mock-adapter": "^2.1.0",
    "babel-plugin-istanbul": "^8.0.0",
    "babel-plugin-transform-import-meta": "^2.3.3",
    "cypress": "^14.5.4",
    "eslint": "9.37.0",
    "eslint-config-expo": "10.0.0",
    "fast-glob": "^3.3.3",
    "istanbul-lib-coverage": "^3.2.2",
    "jest": "^29.7.0",
    "nyc": "^18.0.0",
    "react-native-custom-qr-codes-expo": "^2.2.0",
    "react-test-renderer": "19.1.0",
    "start-server-and-test": "^3.0.11",
    "typescript": "5.9.3"
  },
  "private": true
}
